{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@denaneya/observability": ["packages/observability/src/index.ts"],
      "@denaneya/security": ["packages/security/src/index.ts"],
      "@denaneya/database": ["packages/database/src/index.ts"],
      "@denaneya/payment-core": ["packages/payment-core/src/index.ts"],
      "@denaneya/sms-parser": ["packages/sms-parser/src/index.ts"],
      "@denaneya/fraud-engine": ["packages/fraud-engine/src/index.ts"],
      "@denaneya/gateway-adapters": ["packages/gateway-adapters/src/index.ts"],
      "@denaneya/ledger": ["packages/ledger/src/index.ts"],
      "@denaneya/webhooks": ["packages/webhooks/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    ".turbo",
    "apps/android"
  ]
}
