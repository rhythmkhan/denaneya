    "@denaneya/gateway-adapters": "workspace:*",
    "@denaneya/ledger": "workspace:*",
    "@denaneya/observability": "workspace:*",
    "@denaneya/payment-core": "workspace:*",
    "@denaneya/reconciliation": "workspace:*",
    "@denaneya/security": "workspace:*",
    "@denaneya/sms-parser": "workspace:*",
    "@denaneya/webhooks": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "@node-rs/argon2": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
