    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
