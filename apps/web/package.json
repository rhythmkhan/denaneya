{
  "name": "@denaneya/web",
  "version": "1.0.0",
  "private": true,
  "description": "DenaNeya Web Application: Marketing, Docs, Hosted Checkout, Merchant & Admin Dashboard, REST API",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
