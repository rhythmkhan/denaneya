# ==============================================================================
# DENANEYA PLATFORM CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit actual production credentials or private keys to source control.
# In production, configure these variables directly in the Vercel Project Settings.

# ------------------------------------------------------------------------------
# 1. Platform & Operational Mode Governance
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="DenaNeya"
NEXT_PUBLIC_SUPPORT_EMAIL=support@denaneya.com

# Regulatory Safety Flag: Must remain false.
# DenaNeya operates in SOFTWARE/ORCHESTRATION mode and does NOT hold custodial funds.
REGULATED_FEATURES_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Database (Neon Serverless PostgreSQL - Singapore ap-southeast-1)
# ------------------------------------------------------------------------------
# Pooled connection string (PgBouncer port 5432/6543) for Next.js serverless functions
DATABASE_URL=postgres://denaneya_user:sample_password@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/denaneya?sslmode=require

# Direct connection string (unpooled) exclusively for Drizzle schema migrations and DDL
DIRECT_URL=postgres://denaneya_user:sample_password@ep-sample-123456.ap-southeast-1.aws.neon.tech/denaneya?sslmode=require

# ------------------------------------------------------------------------------
# 3. Asynchronous Messaging & Queues (Upstash QStash)
# ------------------------------------------------------------------------------
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=mock_qstash_token_for_development
QSTASH_CURRENT_SIGNING_KEY=sig_mock_current_key_12345
QSTASH_NEXT_SIGNING_KEY=sig_mock_next_key_67890

# ------------------------------------------------------------------------------
# 4. Authentication (NextAuth / Auth.js & Sessions)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate a 32-byte hex secret: `openssl rand -hex 32`
NEXTAUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# Master Key for AES-256-GCM envelope encryption of merchant secrets (32 bytes hex = 256 bits)
# Generate: `openssl rand -hex 32`
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret for signing DenaNeya outbound webhooks sent to merchants (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=whsec_sample_hmac_secret_for_webhook_signatures_only

# Secret for generating and validating one-time QR pairing tokens for Android devices
DEVICE_PAIRING_SECRET=pairing_secret_hmac_for_authenticating_qr_handshake_tokens

# Android event timestamp tolerance window in seconds (±300 seconds prevents replay)
DEVICE_CLOCK_DRIFT_TOLERANCE_SECONDS=300

# ------------------------------------------------------------------------------
# 6. Payment Gateway Sandbox Credentials
# ------------------------------------------------------------------------------
# SSLCOMMERZ Sandbox
SSLCOMMERZ_STORE_ID=denan66000sandbox
SSLCOMMERZ_STORE_PASSWD=denan66000sandbox@ssl
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SESSION_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# shurjoPay Sandbox
SHURJOPAY_USERNAME=sp_sandbox
SHURJOPAY_PASSWORD=sp_sandbox_pass
SHURJOPAY_PREFIX=NOK
SHURJOPAY_IS_SANDBOX=true
SHURJOPAY_BASE_URL=https://sandbox.shurjopayment.com

# aamarPay Sandbox
AAMARPAY_STORE_ID=aamarpaytest
AAMARPAY_SIGNATURE_KEY=28c78bb1f45112f552b95bc139d2059b
AAMARPAY_IS_SANDBOX=true
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com

# bKash PGW Sandbox (Checkout URL-based Tokenized API)
BKASH_APP_KEY=bkash_sandbox_app_key
BKASH_APP_SECRET=bkash_sandbox_app_secret
BKASH_USERNAME=bkash_sandbox_user
BKASH_PASSWORD=bkash_sandbox_pass
BKASH_IS_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad PGW Sandbox
NAGAD_MERCHANT_ID=683002007104225
NAGAD_MERCHANT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
NAGAD_PG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"
NAGAD_IS_SANDBOX=true
NAGAD_BASE_URL=http://sandbox.mymsg.bd:7080/trust-edge

# ------------------------------------------------------------------------------
# 7. Observability, Telemetry & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
OTEL_SERVICE_NAME=denaneya-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Anti-Fraud Defaults
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX_REQUESTS=120
RATE_LIMIT_API_WINDOW_SECONDS=60

FRAUD_SCORE_AUTO_REJECT_THRESHOLD=80
FRAUD_SCORE_REVIEW_THRESHOLD=50

# ------------------------------------------------------------------------------
# 9. Android Collector Configuration Defaults
# ------------------------------------------------------------------------------
COLLECTOR_DEFAULT_SERVER_URL=https://api.denaneya.com
COLLECTOR_DEFAULT_APP_TAG=DenaNeyaCollector
